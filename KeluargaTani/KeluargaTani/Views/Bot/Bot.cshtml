@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Bot Analisis - Keluarga Tani";
}

<!-- ========================================== -->
<!-- VIEW: BOT ANALISIS KEUANGAN & CASHFLOW     -->
<!-- ========================================== -->
<div id="view-bot" class="app-view space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-700 flex items-center justify-center text-white text-xl shadow">
        🤖
        </div>
        <div>
        <h2 class="text-xl font-black tracking-tight text-slate-800 dark:text-slate-100">Kang Tani - Asisten Keuangan</h2>
        <p class="text-xs text-slate-500 dark:text-slate-400">Analisis mingguan, bulanan, semesteran & evaluasi target margin 30%</p>
        </div>
    </div>

    <!-- Periode Tabs -->
    <div class="inline-flex rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-1 text-xs">
        <button onclick="App.renderBotView('week')" id="bot-tab-week" class="px-3 py-1.5 rounded-lg border-b-2 font-bold transition">Mingguan</button>
        <button onclick="App.renderBotView('month')" id="bot-tab-month" class="px-3 py-1.5 rounded-lg border-b-2 transition">Bulanan</button>
        <button onclick="App.renderBotView('semester')" id="bot-tab-semester" class="px-3 py-1.5 rounded-lg border-b-2 transition">Semesteran</button>
    </div>
    </div>

    <!-- Grid: Health Score & Target Margin 30% Evaluation -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    
    <!-- Health Card -->
    <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex items-center justify-between">
        <div>
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Status Kesehatan Finansial</div>
        <div class="flex items-center space-x-2 mt-1.5">
            <span id="bot-health-status" class="text-2xl font-black text-slate-800 dark:text-slate-100">Sangat Sehat</span>
            <span id="bot-health-badge" class="px-2.5 py-0.5 rounded-full text-xs font-bold margin-badge-green">Sehat</span>
        </div>
        <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">
            Skor Kesehatan: <span id="bot-health-score" class="font-bold text-slate-800 dark:text-slate-200">92/100</span>
        </div>
        </div>
        <div class="w-14 h-14 rounded-2xl bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 flex items-center justify-center text-2xl">
        🛡️
        </div>
    </div>

    <!-- Target Margin 30% Benchmark Card -->
    <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="flex items-center justify-between">
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Evaluasi Target Margin 30%</div>
        <span class="text-xs font-bold text-emerald-600 bg-emerald-50 dark:bg-emerald-950/50 px-2 py-0.5 rounded">Standar Usaha</span>
        </div>
        <div class="flex items-baseline space-x-3 mt-1.5">
        <div class="text-2xl font-black text-slate-800 dark:text-slate-100" id="bot-actual-margin">36.5%</div>
        <div class="text-xs text-slate-500">Target Min: <span id="bot-target-margin-info" class="font-bold">30%</span></div>
        </div>
        <div id="bot-margin-evaluation" class="text-xs font-semibold mt-1 text-emerald-600">
        Target tercapai! Surplus +6.5% di atas batas minimal.
        </div>
    </div>

    </div>

    <!-- Ringkasan Bahasa Ramah & Alasan Analisis -->
    <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
    <h3 class="font-bold text-sm text-slate-800 dark:text-slate-100 flex items-center space-x-2">
        <span>📝 Ringkasan Analisis Kang Tani</span>
    </h3>
    <div id="bot-summary-text" class="text-xs text-slate-700 dark:text-slate-300 leading-relaxed space-y-2 bg-slate-50 dark:bg-slate-800/50 p-4 rounded-xl border border-slate-100 dark:border-slate-800">
        <!-- Diisi oleh bot.js -->
    </div>
    </div>

    <!-- Alerts & Practical Suggestions Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    
    <!-- Peringatan Cerdas (Alerts) -->
    <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
        <h3 class="font-bold text-sm text-slate-800 dark:text-slate-100 flex items-center space-x-2">
        <span>⚠️ Peringatan Dini Cerdas</span>
        </h3>
        <div id="bot-alerts-list" class="space-y-2">
        <!-- Diisi oleh bot.js -->
        </div>
    </div>

    <!-- Saran Praktis Langkah Aksi -->
    <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
        <h3 class="font-bold text-sm text-slate-800 dark:text-slate-100 flex items-center space-x-2">
        <span>💡 Saran Praktis Meningkatkan Keuntungan</span>
        </h3>
        <ul id="bot-suggestions-list" class="space-y-2">
        <!-- Diisi oleh bot.js -->
        </ul>
    </div>

    </div>

    <!-- Target Otomatis Periode Berikutnya -->
    <div class="bg-gradient-to-r from-teal-800 to-emerald-900 rounded-2xl p-6 text-white shadow-md space-y-3">
    <div class="flex items-center justify-between">
        <div>
        <h3 class="font-extrabold text-base tracking-tight">Proyeksi Target Periode Berikutnya</h3>
        <p class="text-xs text-emerald-200 mt-0.5">Rekomendasi sasaran bisnis yang realistis berdasarkan tren penjualan terkini</p>
        </div>
        <span class="px-2.5 py-1 rounded-full bg-white/20 text-xs font-bold">Proyeksi AI</span>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
        <div class="bg-white/10 p-3 rounded-xl backdrop-blur-sm">
        <div class="text-[11px] text-emerald-200 font-medium">Target Omzet</div>
        <div id="bot-target-omzet" class="text-base font-black text-white mt-0.5">Rp 0</div>
        </div>
        <div class="bg-white/10 p-3 rounded-xl backdrop-blur-sm">
        <div class="text-[11px] text-emerald-200 font-medium">Target Profit Bersih</div>
        <div id="bot-target-profit" class="text-base font-black text-emerald-300 mt-0.5">Rp 0</div>
        </div>
        <div class="bg-white/10 p-3 rounded-xl backdrop-blur-sm">
        <div class="text-[11px] text-emerald-200 font-medium">Target Transaksi</div>
        <div id="bot-target-tx" class="text-base font-black text-white mt-0.5">0</div>
        </div>
        <div class="bg-white/10 p-3 rounded-xl backdrop-blur-sm">
        <div class="text-[11px] text-emerald-200 font-medium">Target Margin Minimal</div>
        <div id="bot-target-margin-pct" class="text-base font-black text-amber-300 mt-0.5">30%</div>
        </div>
    </div>
    </div>

    <!-- Dialog Chatbot Interaktif -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden flex flex-col h-96">
    <div class="p-4 border-b border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/50 flex items-center justify-between">
        <div class="flex items-center space-x-2">
        <div class="w-7 h-7 rounded-full bg-emerald-600 text-white flex items-center justify-center text-xs">🤖</div>
        <span class="text-xs font-bold text-slate-800 dark:text-slate-100">Tanya Jawab Finansial Bersama Kang Tani</span>
        </div>
        <span class="text-[11px] text-emerald-600 font-semibold flex items-center space-x-1">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse inline-block"></span>
        <span>Siap Menjawab</span>
        </span>
    </div>

    <!-- Chat messages container -->
    <div id="bot-chat-messages" class="flex-1 p-4 overflow-y-auto space-y-3">
        <div class="flex justify-start mb-3">
        <div class="chat-bubble-bot bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700 px-4 py-3 rounded-2xl max-w-sm sm:max-w-md text-xs shadow-sm whitespace-pre-line">
            Halo! Saya <strong>Kang Tani</strong>, asisten keuangan pribadi Keluarga Tani. Anda dapat menanyakan kondisi keuntungan usaha, evaluasi margin 30%, arus kas, atau rekomendasi produk.
        </div>
        </div>
    </div>

    <!-- Quick Question Chips -->
    <div class="px-4 py-2 bg-slate-50 dark:bg-slate-800/40 border-t border-slate-100 dark:border-slate-800 flex items-center space-x-2 overflow-x-auto text-[11px]">
        <span class="text-slate-400 whitespace-nowrap">Pertanyaan Cepat:</span>
        <button onclick="App.sendBotMessage('Bagaimana kondisi keuangan minggu ini?')" class="px-2.5 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-full hover:border-emerald-500 whitespace-nowrap">Kondisi Minggu Ini?</button>
        <button onclick="App.sendBotMessage('Apakah target margin 30% tercapai?')" class="px-2.5 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-full hover:border-emerald-500 whitespace-nowrap">Target 30% Tercapai?</button>
        <button onclick="App.sendBotMessage('Produk mana yang paling menguntungkan?')" class="px-2.5 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-full hover:border-emerald-500 whitespace-nowrap">Produk Paling Untung?</button>
        <button onclick="App.sendBotMessage('Bagaimana kondisi arus kas cashflow?')" class="px-2.5 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-full hover:border-emerald-500 whitespace-nowrap">Arus Kas Cashflow?</button>
        <button onclick="App.sendBotMessage('Berikan tips untuk menaikkan profit usaha')" class="px-2.5 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-full hover:border-emerald-500 whitespace-nowrap">Tips Menaikkan Profit</button>
    </div>

    <!-- Chat input bar -->
    <div class="p-3 border-t border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-900 flex items-center space-x-2">
        <input type="text" id="bot-chat-input" onkeydown="if(event.key === 'Enter') App.sendBotMessage()" placeholder="Ketik pertanyaan tentang keuangan usaha Anda..." class="flex-1 px-3.5 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs focus:ring-1 focus:ring-emerald-500 focus:outline-none">
        <button onclick="App.sendBotMessage()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-xs shadow transition">
        Kirim
        </button>
    </div>
    </div>

</div>