@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Bot Analisis - Keluarga Tani";
}

<!-- ========================================== -->
<!-- VIEW: BOT ANALISIS KEUANGAN & CASHFLOW     -->
<!-- ========================================== -->
<div id="view-bot" class="app-view space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-700 flex items-center justify-center text-white text-xl shadow">
        🤖
        </div>
        <div>
        <h2 class="text-xl font-black tracking-tight text-slate-800 dark:text-slate-100">Kang Tani - Asisten Keuangan</h2>
        <p class="text-xs text-slate-500 dark:text-slate-400">Analisis mingguan, bulanan, semesteran & evaluasi target margin 30%</p>
        </div>
    </div>

    <!-- Periode Tabs -->
    <div class="inline-flex rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-1 text-xs">
        <button onclick="App.renderBotView('week')" id="bot-tab-week" class="px-3 py-1.5 rounded-lg border-b-2 font-bold transition">Mingguan</button>
        <button onclick="App.renderBotView('month')" id="bot-tab-month" class="px-3 py-1.5 rounded-lg border-b-2 transition">Bulanan</button>
        <button onclick="App.renderBotView('semester')" id="bot-tab-semester" class="px-3 py-1.5 rounded-lg border-b-2 transition">Semesteran</button>
    </div>
    </div>

    <!-- Grid: Health Score & Target Margin 30% Evaluation -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    
    <!-- Health Card -->
    <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex items-center justify-between">
        <div>
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Status Kesehatan Finansial</div>
        <div class="flex items-center space-x-2 mt-1.5">
            <span id="bot-health-status" class="text-2xl font-black text-slate-800 dark:text-slate-100">Sangat Sehat</span>
            <span id="bot-health-badge" class="px-2.5 py-0.5 rounded-full text-xs font-bold margin-badge-green">Sehat</span>
        </div>
        <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">
            Skor Kesehatan: <span id="bot-health-score" class="font-bold text-slate-800 dark:text-slate-200">92/100</span>
        </div>
        </div>
        <div class="w-14 h-14 rounded-2xl bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 flex items-center justify-center text-2xl">
        🛡️
        </div>
    </div>

    <!-- Target Margin 30% Benchmark Card -->
    <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="flex items-center justify-between">
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Evaluasi Target Margin 30%</div>
        <span class="text-xs font-bold text-emerald-600 bg-emerald-50 dark:bg-emerald-950/50 px-2 py-0.5 rounded">Standar Usaha</span>
        </div>
        <div class="flex items-baseline space-x-3 mt-1.5">
        <div class="text-2xl font-black text-slate-800 dark:text-slate-100" id="bot-actual-margin">36.5%</div>
        <div class="text-xs text-slate-500">Target Min: <span id="bot-target-margin-info" class="font-bold">30%</span></div>
        </div>
        <div id="bot-margin-evaluation" class="text-xs font-semibold mt-1 text-emerald-600">
        Target tercapai! Surplus +6.5% di atas batas minimal.
        </div>
    </div>

    </div>

    <!-- Ringkasan Bahasa Ramah & Alasan Analisis -->
    <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
    <h3 class="font-bold text-sm text-slate-800 dark:text-slate-100 flex items-center space-x-2">
        <span>📝 Ringkasan Analisis Kang Tani</span>
    </h3>
    <div id="bot-summary-text" class="bg-slate-50 dark:bg-slate-800/50 p-4 rounded-xl border border-slate-100 dark:border-slate-800">
        <p class="text-xs text-slate-700 dark:text-slate-300 leading-relaxed whitespace-pre-line">Halo! Berdasarkan pembukuan periode ini, usaha Anda mencetak total pendapatan sebesar Rp 15.000.000 dengan pengeluaran Rp 9.525.000. Kondisi keuangan sangat stabil. 
            Pendapatan tertinggi didominasi oleh Penjualan Pupuk NPK yang menyumbang 65% omzet, sementara beban terbesar jatuh pada pengadaan bahan baku. Arus kas berputar dengan baik dan margin bersih Anda mencapai 36.5%, menandakan efisiensi harga jual dan biaya produksi yang sangat ideal.</p>
    </div>
</div>

    <!-- Target Otomatis Periode Berikutnya -->
    <div class="bg-gradient-to-r from-teal-800 to-emerald-900 rounded-2xl p-6 text-white shadow-md space-y-3">
    <div class="flex items-center justify-between">
        <div>
        <h3 class="font-extrabold text-base tracking-tight">Proyeksi Target Periode Berikutnya</h3>
        <p class="text-xs text-emerald-200 mt-0.5">Rekomendasi sasaran bisnis yang realistis berdasarkan tren penjualan terkini</p>
        </div>
        <span class="px-2.5 py-1 rounded-full bg-white/20 text-xs font-bold">Proyeksi AI</span>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
        <div class="bg-white/10 p-3 rounded-xl backdrop-blur-sm">
        <div class="text-[11px] text-emerald-200 font-medium">Target Omzet</div>
        <div id="bot-target-omzet" class="text-base font-black text-white mt-0.5">Rp 0</div>
        </div>
        <div class="bg-white/10 p-3 rounded-xl backdrop-blur-sm">
        <div class="text-[11px] text-emerald-200 font-medium">Target Profit Bersih</div>
        <div id="bot-target-profit" class="text-base font-black text-emerald-300 mt-0.5">Rp 0</div>
        </div>
        <div class="bg-white/10 p-3 rounded-xl backdrop-blur-sm">
        <div class="text-[11px] text-emerald-200 font-medium">Target Transaksi</div>
        <div id="bot-target-tx" class="text-base font-black text-white mt-0.5">0</div>
        </div>
        <div class="bg-white/10 p-3 rounded-xl backdrop-blur-sm">
        <div class="text-[11px] text-emerald-200 font-medium">Target Margin Minimal</div>
        <div id="bot-target-margin-pct" class="text-base font-black text-amber-300 mt-0.5">30%</div>
        </div>
        
    </div>
    <p class="text-sm text-emerald-100 leading-relaxed mt-4 border-t border-emerald-700/50 pt-4">
        <strong class="text-white">💡 Insight Kang Tani:</strong> 
            Kinerja keuangan Anda periode ini sangat luar biasa! <strong>Hal positifnya</strong>, Anda berhasil menjaga margin di atas batas aman 30% dan menekan biaya bahan baku hingga 8%. Penjualan pupuk organik juga menjadi penyumbang kas tercepat. <strong>Namun yang perlu dibenahi</strong> adalah biaya operasional, khususnya ongkos transportasi logistik panen yang naik 12%. Selain itu, perhatikan perputaran stok bibit sayur yang mulai melambat agar modal tidak mengendap.
    </p>
    </div>

    </div>

</div>

@section Scripts{
<script>
    $(document).ready(function() {
        loadAnalisisAI();
    });

    function loadAnalisisAI() {
        $('#bot-summary-text p').text("🤖 Kang Tani sedang memikirkan analisis keuangan Anda...");
        
        $.ajax({
            url: '@Url.Action("GenerateAnalisis", "Bot")',
            type: 'POST',
            success: function(result) {
                $('#bot-summary-text p').text(result.ringkasan);
                $('.bg-gradient-to-r.from-teal-800 p.text-emerald-100').html(
                    `<strong class="text-white">💡 Insight Kang Tani:</strong> ${result.insight}`
                );

                const formatRupiah = new Intl.NumberFormat('id-ID', { 
                    style: 'currency', 
                    currency: 'IDR', 
                    minimumFractionDigits: 0 
                });
                
                $('#bot-target-omzet').text(formatRupiah.format(result.target_omzet));
                $('#bot-target-profit').text(formatRupiah.format(result.target_profit));                
                $('#bot-target-tx').text(result.target_transaksi);                
                $('#bot-target-margin-pct').text(result.target_margin + '%');
            },
            error: function(xhr, status, error) {
                $('#bot-summary-text p').text("⚠️ Gagal menghubungi asisten AI");
            }
        });
    }

    
</script>
}