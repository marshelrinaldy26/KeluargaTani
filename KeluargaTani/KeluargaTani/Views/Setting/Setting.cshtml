<!-- ========================================== -->
<!-- VIEW: PENGATURAN & PROFIL                 -->
<!-- ========================================== -->
<div id="view-settings" class="app-view space-y-6">
    <div>
    <h2 class="text-xl font-black tracking-tight text-slate-800 dark:text-slate-100">Pengaturan Usaha & Keamanan</h2>
    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Kelola profil usaha, kata sandi akun, data contoh, serta pencadangan data</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

    <!-- Profil Usaha Form -->
    <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
        <h3 class="font-bold text-sm text-slate-800 dark:text-slate-100">Profil Usaha Pribadi</h3>
        <form onsubmit="App.handleSettingsSubmit(event)" class="space-y-3">
        <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Nama Toko / Usaha</label>
            <input type="text" id="set-biz-name" required class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs">
        </div>
        <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Nama Pemilik</label>
            <input type="text" id="set-owner-name" required class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs">
        </div>
        <div class="grid grid-cols-2 gap-2">
            <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Nomor Telp / WA</label>
            <input type="text" id="set-phone" class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs">
            </div>
            <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Target Margin Min (%)</label>
            <input type="number" id="set-margin-target" value="30" class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs font-bold text-emerald-600">
            </div>
        </div>
        <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Alamat Usaha</label>
            <textarea id="set-address" rows="2" class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs"></textarea>
        </div>
        <div>
            <label class="block text-xs font-semibold text-slate-400 mb-1">Username Akun</label>
            <div id="set-username-static" class="text-xs font-mono font-bold text-slate-700 dark:text-slate-300 px-3 py-2 bg-slate-100 dark:bg-slate-800 rounded-xl"></div>
        </div>
        <button type="submit" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-xs shadow transition">
            Simpan Perubahan Profil
        </button>
        </form>
    </div>

    <!-- Ganti Password & Keamanan -->
    <div class="space-y-6">
        
        <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
        <h3 class="font-bold text-sm text-slate-800 dark:text-slate-100">Ubah Kata Sandi</h3>
        <form id="form-change-password" onsubmit="App.handleChangePasswordSubmit(event)" class="space-y-3">
            <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Kata Sandi Lama</label>
            <input type="password" id="set-old-pass" required class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs">
            </div>
            <div class="grid grid-cols-2 gap-2">
            <div>
                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Sandi Baru</label>
                <input type="password" id="set-new-pass" required minlength="6" class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs">
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Ulangi Sandi Baru</label>
                <input type="password" id="set-confirm-pass" required minlength="6" class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs">
            </div>
            </div>
            <button type="submit" class="px-4 py-2 bg-slate-800 dark:bg-slate-700 hover:bg-slate-900 text-white font-bold rounded-xl text-xs shadow transition">
            Perbarui Kata Sandi
            </button>
        </form>
        </div>

        <!-- Cadangan & Pemulihan Data JSON -->
        <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
        <h3 class="font-bold text-sm text-slate-800 dark:text-slate-100">Pencadangan & Simulasi Data</h3>
        <p class="text-xs text-slate-400">Unduh berkas JSON cadangan atau muat data contoh simulasi usaha.</p>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1">
            <button onclick="App.exportBackup()" class="px-3 py-2 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800 rounded-xl text-xs font-bold hover:bg-emerald-100 transition text-center">
            📥 Ekspor Cadangan (JSON)
            </button>

            <label class="px-3 py-2 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-xl text-xs font-bold hover:bg-slate-200 transition text-center cursor-pointer">
            📤 Pulihkan Cadangan
            <input type="file" accept=".json" onchange="App.importBackup(this)" class="hidden">
            </label>

            <button onclick="App.loadDemoData()" class="px-3 py-2 bg-teal-600 text-white rounded-xl text-xs font-bold hover:bg-teal-700 transition text-center">
            🌱 Muat Data Contoh
            </button>

            <button onclick="App.resetUserData()" class="px-3 py-2 bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-300 border border-red-300 dark:border-red-800 rounded-xl text-xs font-bold hover:bg-red-100 transition text-center">
            🗑️ Kosongkan Seluruh Data
            </button>
        </div>
        </div>

    </div>

    </div>
    </div>

    </main>
    </div>
</div>