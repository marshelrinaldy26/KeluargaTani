@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Settings - Keluarga Tani";
}

<div id="view-settings" class="app-view space-y-6">
    <div>
    <h2 class="text-xl font-black tracking-tight text-slate-800 dark:text-slate-100">Pengaturan Usaha & Keamanan</h2>
    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Kelola profil usaha, kata sandi akun, data contoh, serta pencadangan data</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

    <!-- Profil Usaha Form -->
    <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
        <h3 class="font-bold text-sm text-slate-800 dark:text-slate-100">Profil Usaha Pribadi</h3>
        <form onsubmit="handleSettingsSubmit(event)" class="space-y-3">
        <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Nama Toko / Usaha</label>
            <input type="text" id="set-biz-name" required class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs">
        </div>
        <div class="grid grid-cols-2 gap-2">
            <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Nomor Telp / WA</label>
            <input type="text" id="set-phone" class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs">
            </div>
            <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Target Margin Min (%)</label>
            <input type="number" id="set-margin-target" class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs font-bold text-emerald-600">
            </div>
        </div>
        <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Alamat Usaha</label>
            <textarea id="set-address" rows="2" class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs"></textarea>
        </div>

        <button type="submit" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-xs shadow transition">
            Simpan Perubahan Profil
        </button>
        </form>
    </div>

    </div>
    </div>

    </main>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function() {
        loadSettings();
    });

    function loadSettings() {
        Swal.fire({
            title: "Memuat Data...",
            allowOutsideClick: false,
            didOpen: () => { Swal.showLoading(); }
        });

        $.ajax({
            url: '@Url.Action("GetSettingData", "Setting")',
            type: 'GET',
            success: function(res) {
                if(res.success && res.data) {
                    $('#set-biz-name').val(res.data.namaUsaha);
                    $('#set-phone').val(res.data.noTelp);
                    $('#set-margin-target').val(res.data.targetMargin);
                    $('#set-address').val(res.data.alamatUsaha);
                }
                Swal.close();
            },
            error: function(err) {
                console.error(err);
                Swal.close();
            }
        });
    }

    function handleSettingsSubmit(e) {
        e.preventDefault();

        let vm = {
            namaUsaha: $('#set-biz-name').val(),
            noTelp: $('#set-phone').val(),
            targetMargin: $('#set-margin-target').val(),
            alamatUsaha: $('#set-address').val()
        };

        Swal.fire({
            title: "Menyimpan...",
            allowOutsideClick: false,
            didOpen: () => { Swal.showLoading(); }
        });

        $.ajax({
            url: '@Url.Action("SaveSettingData", "Setting")',
            type: 'POST',
            data: vm,
            success: function(res) {
                if(res.success) {
                    Swal.fire({
                        title: 'Berhasil',
                        text: 'Pengaturan berhasil disimpan!',
                        icon: 'success'
                    });
                } else {
                    Swal.fire('Gagal', res.message, 'error');
                }
            },
            error: function(err) {
                console.error(err);
                Swal.fire('Error', 'Terjadi kesalahan pada server', 'error');
            }
        });
    }
</script>
}