@{
    Layout = "~/Views/Shared/_LayoutNull.cshtml";
    ViewData["Title"] = "Masuk - Keluarga Tani";
}

<body class="h-full bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 transition-colors duration-200">
  <div id="auth-container" class="min-h-screen flex items-center justify-center p-4 bg-gradient-to-br from-emerald-900 via-slate-900 to-emerald-950">
    <div class="max-w-md w-full bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-emerald-800/30 overflow-hidden">      
      <div class="p-6 bg-gradient-to-r from-emerald-700 to-teal-800 text-white text-center">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-white/10 mb-3 border border-white/20">
          <svg class="w-8 h-8 text-emerald-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
        </div>
        <h1 class="text-2xl font-extrabold tracking-tight">Keluarga Tani</h1>
        <p class="text-xs text-emerald-100 mt-1">Sistem Pencatatan Penjualan & Asisten Keuangan Pribadi</p>
      </div>

      <div class="p-6 sm:p-8">
        <!-- FORM LOGIN -->
        <div id="form-login-box">
          <div class="text-center mb-6">
            <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">Masuk ke Akun Anda</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Seluruh data penjualan Anda tersimpan privat & aman</p>
          </div>

          <form id="form-login" onsubmit="submitLogin(event)" class="space-y-4">
            <div>
              <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider mb-1.5">Username</label>
              <input type="text" id="login-username" required class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none" placeholder="Masukkan username">
            </div>

            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider">Kata Sandi</label>
                <button type="button" onclick="App.showAuthForm('forgot')" class="text-xs text-emerald-600 dark:text-emerald-400 hover:underline">Lupa Sandi?</button>
              </div>
              <input type="password" id="login-password" required class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none" placeholder="••••••••">
            </div>

            <button type="submit" class="w-full py-3 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg shadow-md hover:shadow-lg transition text-sm">
              Masuk Sekarang
            </button>
          </form>

          <div class="mt-6 text-center text-xs text-slate-500 dark:text-slate-400">
            Belum memiliki akun? 
            <button onclick="App.showAuthForm('register')" class="text-emerald-600 dark:text-emerald-400 font-bold hover:underline">Daftar Akun Baru</button>
          </div>
        </div>

        <!-- FORM REGISTER -->
        <div id="form-register-box" class="hidden">
          <div class="text-center mb-5">
            <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">Daftar Akun Baru</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Buat ruang data terisolasi untuk usaha pribadi Anda</p>
          </div>

          <form id="form-register" class="space-y-3.5">
            <div>
              <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Username Pengguna</label>
              <input type="text" id="reg-username" required class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm" placeholder="Contoh: pak_budi">
            </div>

            <div class="grid grid-cols-2 gap-2.5">
              <div>
                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Nama Usaha / Toko</label>
                <input type="text" id="reg-biz-name" required value="Keluarga Tani" class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm">
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Nama Pemilik</label>
                <input type="text" id="reg-owner-name" required class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm" placeholder="Nama Anda">
              </div>
            </div>

            <div class="grid grid-cols-2 gap-2.5">
              <div>
                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Kata Sandi</label>
                <input type="password" id="reg-password" required minlength="6" class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm" placeholder="Min. 6 digit">
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Ulangi Sandi</label>
                <input type="password" id="reg-confirm-password" required minlength="6" class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm" placeholder="Min. 6 digit">
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Pertanyaan Keamanan (Pemulihan Sandi)</label>
              <select id="reg-security-question" class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm">
                <option value="Apa nama hewan peliharaan pertama Anda?">Apa nama hewan peliharaan pertama Anda?</option>
                <option value="Di kota apa Anda dilahirkan?">Di kota apa Anda dilahirkan?</option>
                <option value="Apa nama sekolah dasar pertama Anda?">Apa nama sekolah dasar pertama Anda?</option>
                <option value="Apa tanaman pertanian favorit Anda?">Apa tanaman pertanian favorit Anda?</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Jawaban Keamanan</label>
              <input type="text" id="reg-security-answer" required class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm" placeholder="Jawaban rahasia Anda">
            </div>

            <button type="submitDaftar" class="w-full py-2.5 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg shadow transition text-sm mt-2">
              Daftar Sekarang
            </button>
          </form>

          <div class="mt-4 text-center text-xs text-slate-500">
            Sudah punya akun? 
            <button onclick="App.showAuthForm('login')" class="text-emerald-600 font-bold hover:underline">Masuk</button>
          </div>
        </div>

        <!-- FORM FORGOT PASSWORD -->
        <div id="form-forgot-box" class="hidden">
          <div class="text-center mb-5">
            <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">Pemulihan Kata Sandi</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Verifikasi pertanyaan keamanan akun Anda</p>
          </div>

          <div id="forgot-step-1" class="space-y-4">
            <div>
              <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Masukkan Username Anda</label>
              <input type="text" id="forgot-username" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm" placeholder="Username terdaftar">
            </div>
            <button type="button" id="btn-find-reset-user" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg text-sm">
              Cari Akun
            </button>
          </div>

          <form id="form-forgot" class="hidden space-y-4">
            <div id="forgot-step-2" class="space-y-3.5">
              <div class="p-3 bg-emerald-50 dark:bg-emerald-950/40 rounded-lg text-xs border border-emerald-200 dark:border-emerald-800">
                <div class="text-slate-500 dark:text-slate-400">Pertanyaan Keamanan:</div>
                <div id="forgot-display-question" class="font-bold text-slate-800 dark:text-slate-100 mt-1"></div>
              </div>

              <div>
                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Jawaban Anda</label>
                <input type="text" id="forgot-answer" required class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm">
              </div>

              <div>
                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Kata Sandi Baru</label>
                <input type="password" id="forgot-new-pass" required minlength="6" class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm" placeholder="Minimal 6 karakter">
              </div>

              <button type="submitPassword" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg text-sm">
                Simpan Kata Sandi Baru
              </button>
            </div>
          </form>

          <div class="mt-4 text-center text-xs text-slate-500">
            <button onclick="App.showAuthForm('login')" class="text-emerald-600 font-bold hover:underline">Kembali ke Halaman Masuk</button>
          </div>
        </div>

      </div>
    </div>
  </div>

  <script>
    const App = {
        showAuthForm: function(formType) {
            $('#form-login-box').addClass('hidden');
            $('#form-register-box').addClass('hidden');
            $('#form-forgot-box').addClass('hidden');
            if (formType === 'login') $('#form-login-box').removeClass('hidden');
            if (formType === 'register') $('#form-register-box').removeClass('hidden');
            if (formType === 'forgot') $('#form-forgot-box').removeClass('hidden');
        },
    };

    function submitLogin(e) {
        e.preventDefault();
        let username = $('#login-username').val();
        let password = $('#login-password').val();
        
        $.ajax({
            url: '@Url.Action("LoginAccount", "Home")',
            type: 'POST',
            data: {
                username: username,
                password: password
            },
            success: function(res) {
                if(res.success) {
                    window.location.href = '@Url.Action("Dashboard", "Dashboard")';
                } else {
                    alert(res.message);
                }
            },
            error: function() {
                alert("Terjadi kesalahan pada server.");
            }
        });
    }

  </script>

</body>

