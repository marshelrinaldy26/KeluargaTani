<!DOCTYPE html>
<html lang="id" class="h-full">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - Keluarga Tani</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#ecfdf5',
              100: '#d1fae5',
              200: '#a7f3d0',
              300: '#6ee7b7',
              400: '#34d399',
              500: '#10b981',
              600: '#059669',
              700: '#047857',
              800: '#065f46',
              900: '#064e3b',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="h-full bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 transition-colors duration-200">

  <!-- ========================================== -->
  <!-- 2. MAIN APPLICATION SHELL                  -->
  <!-- ========================================== -->
  <div id="app-shell" class="min-h-screen flex flex-col md:flex-row bg-slate-50 dark:bg-slate-950">

    <div id="sidebar-backdrop" onclick="App.closeMobileSidebar()" class="fixed inset-0 bg-slate-900/60 z-30 hidden md:hidden"></div>

    <!-- SIDEBAR -->
    <aside id="sidebar" class="fixed md:sticky top-0 left-0 bottom-0 z-40 w-64 bg-emerald-900 dark:bg-slate-900 text-slate-100 flex flex-col border-r border-emerald-800 dark:border-slate-800 transform -translate-x-full md:translate-x-0 transition-sidebar h-screen overflow-y-auto">
      
      <!-- Brand Logo -->
      <div class="p-5 flex items-center justify-between border-b border-emerald-800/80 dark:border-slate-800">
        <div class="flex items-center space-x-3">
          <div class="w-9 h-9 rounded-xl bg-emerald-600 flex items-center justify-center text-white shadow-md">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
          </div>
          <div>
            <div class="font-extrabold text-base tracking-tight text-white user-biz-name">Keluarga Tani</div>
            <div class="text-[10px] text-emerald-300 font-medium">Pencatatan & Analisis</div>
          </div>
        </div>
        <button onclick="App.closeMobileSidebar()" class="md:hidden text-emerald-300 hover:text-white p-1">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <!-- Navigation Menu -->
      <nav class="flex-1 p-3 space-y-1">
        <button onclick="App.navigateTo('dashboard')" data-view="dashboard" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-semibold transition text-emerald-100 hover:bg-emerald-800/60">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
          <span>Dashboard</span>
        </button>

        <button onclick="App.navigateTo('sales')" data-view="sales" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-semibold transition text-emerald-100 hover:bg-emerald-800/60">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          <span>Data Penjualan</span>
        </button>

        <button onclick="App.navigateTo('products')" data-view="products" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-semibold transition text-emerald-100 hover:bg-emerald-800/60">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
          <span>Produk & Kategori</span>
        </button>

        <button onclick="App.navigateTo('customers')" data-view="customers" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-semibold transition text-emerald-100 hover:bg-emerald-800/60">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          <span>Data Pembeli</span>
        </button>

        <button onclick="App.navigateTo('reports')" data-view="reports" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-semibold transition text-emerald-100 hover:bg-emerald-800/60">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
          <span>Laporan & Analitik</span>
        </button>

        <button onclick="App.navigateTo('calculator')" data-view="calculator" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-semibold transition text-emerald-100 hover:bg-emerald-800/60">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
          <span>Kalkulator Usaha</span>
        </button>

        <button onclick="App.navigateTo('bot')" data-view="bot" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-semibold transition text-emerald-100 hover:bg-emerald-800/60 relative">
          <svg class="w-5 h-5 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          <span class="flex-1 text-left">Bot Keuangan</span>
          <span class="px-1.5 py-0.5 rounded text-[10px] bg-amber-400 text-slate-900 font-extrabold">30% Target</span>
        </button>

        <button onclick="App.navigateTo('settings')" data-view="settings" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-semibold transition text-emerald-100 hover:bg-emerald-800/60">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          <span>Pengaturan</span>
        </button>
      </nav>

      <!-- User Profile & Quick Actions -->
      <div class="p-4 border-t border-emerald-800/80 dark:border-slate-800 space-y-3">
        <div class="flex items-center space-x-3 bg-emerald-800/50 dark:bg-slate-800/60 p-2.5 rounded-xl">
          <div class="w-8 h-8 rounded-full bg-emerald-500 text-white font-bold flex items-center justify-center text-xs">
            KT
          </div>
          <div class="flex-1 min-w-0">
            <div class="text-xs font-bold text-white truncate user-display-name">Pemilik Usaha</div>
            <div class="text-[10px] text-emerald-300 truncate">Akun Privat Terisolasi</div>
          </div>
        </div>

        <div class="flex items-center justify-between pt-1">
          <!-- Toggle Dark Mode -->
          <button onclick="App.toggleTheme()" title="Ubah Tema Terang/Gelap" class="flex items-center space-x-1.5 text-xs text-emerald-200 hover:text-white px-2 py-1.5 rounded-lg hover:bg-emerald-800 dark:hover:bg-slate-800 transition">
            <svg class="w-4 h-4 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
            <svg class="w-4 h-4 hidden dark:block text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
            <span>Tema</span>
          </button>

          <!-- Logout -->
          <button onclick="App.logout()" title="Keluar Akun" class="flex items-center space-x-1 text-xs text-red-300 hover:text-red-100 px-2 py-1.5 rounded-lg hover:bg-red-900/40 transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
            <span>Keluar</span>
          </button>
        </div>
      </div>
    </aside>

    <div class="flex-1 flex flex-col min-w-0 overflow-hidden h-screen">
      <header id="header-bar" class="md:hidden bg-emerald-800 dark:bg-slate-900 text-white px-4 py-3 flex items-center justify-between shadow-md">
        <button onclick="App.toggleMobileSidebar()" class="p-1 rounded-lg hover:bg-emerald-700">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
        <div class="font-bold text-sm tracking-tight user-biz-name">Keluarga Tani</div>
        <button onclick="App.toggleTheme()" class="p-1 rounded-lg hover:bg-emerald-700">
          <svg class="w-5 h-5 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
          <svg class="w-5 h-5 hidden dark:block text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        </button>
      </header>

      <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl w-full mx-auto space-y-6 overflow-y-auto">
         @RenderBody()
      </main>
    </div>
  </div>

  <script src="~/lib/jquery/dist/jquery.min.js"></script>
  <script>
    const App = {
        toggleMobileSidebar: function() {
            $('#sidebar').toggleClass('-translate-x-full');
            $('#sidebar-backdrop').toggleClass('hidden');
        },
        closeMobileSidebar: function() {
            $('#sidebar').addClass('-translate-x-full');
            $('#sidebar-backdrop').addClass('hidden');
        },
        toggleTheme: function() {
            $('html').toggleClass('dark');
        },
        navigateTo: function(viewId) {
            switch(viewId) {
                case "dashboard": 
                    window.location.href = '@Url.Action("Dashboard", "Dashboard")';
                    break;
                case "sales":
                    window.location.href = '@Url.Action("Sales", "Sales")';
                    break;
                case "products":
                    window.location.href = '@Url.Action("products", "products")';
                    break;
                default: 
                    window.location.href = '@Url.Action("Dashboard", "Dashboard")';
                    break;
            }
        },
        logout: function() {
            window.location.href = '/Home/login';
        }
    };
  </script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
