@using KeluargaTani.Service
@inject ISettingService SettingService
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dashboard - Keluarga Tani";
    var appSettings = await SettingService.GetGlobalSettingsAsync();
}

<div id="view-dashboard" class="app-view space-y-6">
    <!-- Welcome & Action Banner -->
    <div class="bg-gradient-to-r from-emerald-600 to-teal-700 rounded-2xl p-6 text-white shadow-lg flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <div class="inline-flex items-center space-x-2 text-xs font-semibold bg-white/20 px-3 py-1 rounded-full text-emerald-100 mb-2">
        <span>🌱 Ruang Usaha Pribadi</span>
        <span>•</span>
        <span id="dash-current-date">Hari Ini</span>
        </div>
        <h2 class="text-2xl font-black tracking-tight">Selamat Datang, <span class="user-display-name">Sahabat Tani</span>!</h2>
        <p class="text-xs text-emerald-100 mt-1 max-w-xl">
        Pantau omzet, laba bersih, dan arus kas usaha Anda secara privat. Target perusahaan: minimal margin 30% per minggu.
        </p>
    </div>
    <div class="flex flex-wrap items-center gap-2.5">
        <button onclick="openSalesCase()" class="px-4 py-2.5 bg-white text-emerald-800 hover:bg-emerald-50 font-bold rounded-xl shadow text-xs flex items-center space-x-2 transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        <span>Catat Penjualan Baru</span>
        </button>
    </div>
    </div>

    <!-- KPI Summary Grid (6 Cards) -->
    <div class="grid grid-cols-2 lg:grid-cols-6 gap-3.5 sm:gap-4">
    
    <!-- Omzet Penjualan -->
    <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm col-span-1 lg:col-span-2">
        <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Total Penjualan (Omzet)</span>
        <div class="w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 flex items-center justify-center">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        </div>
        <div id="dash-total-sales" class="text-xl sm:text-2xl font-black text-slate-800 dark:text-slate-100 tracking-tight"></div>
        <div class="text-[11px] text-slate-400 mt-1">Penerimaan kas bersih penjualan</div>
    </div>

    <!-- Total Modal -->
    <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm col-span-1 lg:col-span-2">
        <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Total Modal (Harga Pokok)</span>
        <div class="w-8 h-8 rounded-lg bg-red-100 dark:bg-red-950/60 text-red-600 flex items-center justify-center">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
        </div>
        </div>
        <div id="dash-total-cost" class="text-xl sm:text-2xl font-black text-slate-800 dark:text-slate-100 tracking-tight"></div>
        <div class="text-[11px] text-slate-400 mt-1">Biaya pengadaan barang dagang</div>
    </div>

    <!-- Laba Bersih / Profit -->
    <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm col-span-2 lg:col-span-2">
        <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Total Laba Bersih (Profit)</span>
        <div class="w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-950/60 text-blue-600 flex items-center justify-center">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
        </div>
        </div>
        <div id="dash-total-profit" class="text-xl sm:text-2xl font-black text-emerald-600 dark:text-emerald-400 tracking-tight"></div>
        <div class="text-[11px] text-slate-400 mt-1">Omzet dikurangi modal bersih dan diskon</div>
    </div>

    <!-- Rata-rata Margin % -->
    <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm col-span-1 lg:col-span-2">
        <div class="flex items-center justify-between mb-1.5">
        <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Rata-Rata Margin</span>
        <span id="dash-margin-badge" class="px-2 py-0.5 rounded text-[10px] font-bold margin-badge-green">Target ≥30%</span>
        </div>
        <div id="dash-avg-margin" class="text-xl sm:text-2xl font-black text-slate-800 dark:text-slate-100"></div>
        <div class="text-[11px] text-slate-400 mt-1">Standar target usaha: min. @appSettings.TargetMargin%</div>
    </div>

    <!-- Total Diskon Diberikan -->
    <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm col-span-1 lg:col-span-2">
        <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Total Potongan Diskon</span>
        <div class="w-8 h-8 rounded-lg bg-amber-100 dark:bg-amber-950/60 text-amber-600 flex items-center justify-center">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
        </div>
        </div>
        <div id="dash-total-discount" class="text-xl sm:text-2xl font-black text-slate-800 dark:text-slate-100 tracking-tight"></div>
        <div class="text-[11px] text-slate-400 mt-1">Akumulasi diskon ke pembeli</div>
    </div>

    <!-- Jumlah Transaksi -->
    <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm col-span-2 lg:col-span-2">
        <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Aktivitas Penjualan</span>
        <div class="w-8 h-8 rounded-lg bg-purple-100 dark:bg-purple-950/60 text-purple-600 flex items-center justify-center">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
        </div>
        </div>
        <div id="dash-total-tx" class="text-xl sm:text-2xl font-black text-slate-800 dark:text-slate-100"></div>
        <div class="text-[11px] text-slate-400 mt-1">Total nota transaksi tercatat</div>
    </div>

    </div>

    <!-- BOT KEUANGAN HIGHLIGHT CARD -->
    <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
    <div class="flex items-start space-x-3.5">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-700 flex items-center justify-center text-white text-xl shadow flex-shrink-0">
        🤖
        </div>
        <div>
        <div class="flex items-center space-x-2">
            <h3 class="font-bold text-slate-800 dark:text-slate-100 text-sm">Bot Keuangan Kang Tani</h3>
            <span id="dash-bot-status" class="px-2 py-0.5 rounded text-[11px] font-bold margin-badge-green">Sehat</span>
        </div>
        <p id="dash-bot-summary" class="text-xs text-slate-600 dark:text-slate-300 mt-1 max-w-3xl leading-relaxed">
            Memuat analisis kesehatan keuangan usaha Anda...
        </p>
        </div>
    </div>
    <button onclick="navigateTo('bot')" class="px-4 py-2 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-100 font-bold rounded-xl text-xs border border-emerald-200 dark:border-emerald-800 transition whitespace-nowrap">
        Buka Analisis Lengkap & Saran →
    </button>
    </div>

    <!-- Interactive Charts Section -->
    <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 dark:border-slate-800 pb-4">
        <div>
        <h3 class="font-bold text-base text-slate-800 dark:text-slate-100">Grafik Kinerja & Arus Kas</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400">Visualisasi tren omzet, profit, evaluasi margin 30%, dan cashflow</p>
        </div>
        <div class="flex items-center space-x-2">
        <label class="text-xs text-slate-500 font-medium">Tampilan:</label>
        <select id="chart-period-select" onchange="renderCharts()" class="text-xs px-3 py-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 font-medium focus:ring-1 focus:ring-emerald-500">
            <option value="daily">Harian</option>
            <option value="weekly" selected>Mingguan</option>
            <option value="monthly">Bulanan</option>
            <option value="semester">Semesteran</option>
        </select>
        </div>
    </div>

    <!-- 4 Charts Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 pt-2">
        <!-- Chart 1: Tren Penjualan & Profit -->
        <div class="space-y-2">
        <div class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center justify-between">
            <span>Tren Penjualan & Profit Bersih</span>
            <span class="text-[11px] text-slate-400">Rp</span>
        </div>
        <div class="h-64 relative">
            <div id="chart-sales-profit" class="w-full h-full"></div>
        </div>
        </div>

        <!-- Chart 2: Tren Margin vs Target 30% -->
        <div class="space-y-2">
        <div class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center justify-between">
            <span>Tren Margin vs Garis Batas 30%</span>
            <span class="text-[11px] text-emerald-600 font-bold">Target Min: @appSettings.TargetMargin%</span>
        </div>
        <div class="h-64 relative">
            <div id="chart-margin" class="w-full h-full"></div>
        </div>
        </div>

        <!-- Chart 3: Arus Kas / Cashflow (Inflow vs Outflow) -->
        <div class="space-y-2">
        <div class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center justify-between">
            <span>Arus Kas (Kas Masuk Penjualan vs Modal Keluar)</span>
            <span class="text-[11px] text-slate-400">Cashflow</span>
        </div>
        <div class="h-64 relative">
            <div id="chart-cashflow" class="w-full h-full"></div>
        </div>
        </div>

        <!-- Chart 4: Proporsi Produk -->
        <div class="space-y-2">
        <div class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center justify-between">
            <span>Distribusi Penjualan per Produk</span>
            <span class="text-[11px] text-slate-400">Pangsa Omzet</span>
        </div>
        <div class="h-64 relative flex items-center justify-center">
            <div id="chart-category" class="w-full h-full"></div>
        </div>
        </div>
    </div>
    </div>
</div>

@section Scripts {
<script>
    let chartSalesProfit, chartMargin, chartCashflow, chartCategory;

    $(document).ready(function(){
        loadDataDashboard();
        renderCharts();
    });

    function renderCharts() {
        let period = $('#chart-period-select').val();
        $.ajax({
            url: '@Url.Action("GetChartData", "Dashboard")',
            type: 'GET',
            data: { period: period },
            success: function(response){
                if(response.success) {
                    updateCharts(response.data);
                }
            },
            error: function(err) {
                console.error("Gagal load chart data", err);
            }
        });
    }

    function updateCharts(data) {
        let optSales = {
            series: [{ name: 'Laba Bersih', type: 'column', data: data.profitSeries }, { name: 'Omzet', type: 'line', data: data.salesSeries }],
            chart: { height: 250, type: 'line', toolbar: { show: false } },
            stroke: { width: [0, 3], curve: 'smooth' },
            colors: ['#3b82f6', '#10b981'],
            labels: data.labels,
            yaxis: [{ labels: { formatter: function(y) { return y ? "Rp " + y.toLocaleString('id-ID') : "Rp 0"; } } }]
        };
        if(chartSalesProfit) chartSalesProfit.destroy();
        chartSalesProfit = new ApexCharts(document.querySelector("#chart-sales-profit"), optSales);
        chartSalesProfit.render();

        let optMargin = {
            series: [{ name: 'Margin (%)', data: data.marginSeries }],
            chart: { height: 250, type: 'line', toolbar: { show: false } },
            stroke: { width: 3, curve: 'smooth' },
            colors: ['#0f766e'],
            labels: data.labels,
            annotations: { yaxis: [{ y: 30, borderColor: '#ef4444', strokeDashArray: 4, label: { borderColor: '#ef4444', style: { color: '#fff', background: '#ef4444' }, text: 'Target 30%' } }] },
            yaxis: { max: 100, labels: { formatter: function(y) { return y ? y.toFixed(1) + "%" : "0%"; } } }
        };
        if(chartMargin) chartMargin.destroy();
        chartMargin = new ApexCharts(document.querySelector("#chart-margin"), optMargin);
        chartMargin.render();

        let optCashflow = {
            series: [{ name: 'Kas Masuk', data: data.salesSeries }, { name: 'Modal Keluar', data: data.costSeries }],
            chart: { type: 'bar', height: 250, toolbar: { show: false } },
            plotOptions: { bar: { horizontal: false, columnWidth: '55%', endingShape: 'rounded' } },
            dataLabels: { enabled: false },
            stroke: { show: true, width: 2, colors: ['transparent'] },
            xaxis: { categories: data.labels },
            yaxis: { labels: { formatter: function(val) { return val ? "Rp " + val.toLocaleString('id-ID') : "Rp 0"; } } },
            fill: { opacity: 1 },
            colors: ['#10b981', '#ef4444']
        };
        if(chartCashflow) chartCashflow.destroy();
        chartCashflow = new ApexCharts(document.querySelector("#chart-cashflow"), optCashflow);
        chartCashflow.render();

        let optCat = {
            series: data.categorySeries,
            chart: { type: 'donut', height: 250 },
            labels: data.categoryLabels,
            legend: { position: 'bottom' }
        };
        if(chartCategory) chartCategory.destroy();
        chartCategory = new ApexCharts(document.querySelector("#chart-category"), optCat);
        chartCategory.render();
    }

    function loadDataDashboard()
    {
        Swal.fire({
            title: "Memuat Data...",
            text: "Silahkan tunggu sebentar",
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });
        $.ajax({
            url: '@Url.Action("GetSummary", "Dashboard")',
            type: 'GET',
            success: function(response){
                console.log('response : ', response);
                if(response.success) {
                    var data = response.data;
                    $('#dash-total-sales').text('Rp ' + data.totalSales.toLocaleString('id-ID'));
                    $('#dash-total-cost').text('Rp ' + data.totalCost.toLocaleString('id-ID'));
                    $('#dash-total-profit').text('Rp ' + data.totalProfit.toLocaleString('id-ID'));
                    $('#dash-avg-margin').text(data.avgMargin + '%');
                    $('#dash-total-discount').text('Rp ' + data.totalDiscount.toLocaleString('id-ID'));
                    $('#dash-total-tx').text(data.totalTransactions + ' Transaksi');
                } else {
                    console.error("Gagal: " + response.message);
                }
                Swal.close();
            },
            error: function(err){
                console.error(err);
                Swal.close();
            }
        });
    }

    function openSalesCase()
    {
        window.location.href = '@Url.Action("Sales", "Sales")';
    }
</script>
}