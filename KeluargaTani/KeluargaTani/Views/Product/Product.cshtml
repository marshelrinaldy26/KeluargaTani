@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Product - Keluarga Tani";
}

 <!-- ========================================== -->
<!-- VIEW: MANAJEMEN PRODUK                    -->
<!-- ========================================== -->
<div id="view-products" class="app-view space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div>
        <h2 class="text-xl font-black tracking-tight text-slate-800 dark:text-slate-100">Manajemen Produk & Stok</h2>
        <p id="products-count-info" class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Memuat data produk...</p>
    </div>
    <button onclick="openProductModal()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl shadow transition flex items-center space-x-1.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        <span>Tambah Produk Baru</span>
    </button>
    </div>

    <!-- Product Table -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
        <thead>
            <tr class="bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 font-bold uppercase text-[10px]">
            <th class="py-3 px-3 text-center">No</th>
            <th class="py-3 px-3">Nama Produk</th>
            <th class="py-3 px-3">Kategori</th>
            <th class="py-3 px-3 text-center">Estimasi Margin</th>
            <th class="py-3 px-3 text-center">Stok</th>
            <th class="py-3 px-3 text-center">Status</th>
            <th class="py-3 px-3 text-center">Aksi</th>
            </tr>
        </thead>
        <tbody id="products-table-tbody">
            <!-- Data diisi oleh JavaScript -->
        </tbody>
        </table>
    </div>

    <div id="products-empty-state" class="hidden py-12 px-4 text-center">
        <div class="text-3xl mb-2">🌱</div>
        <h4 class="font-bold text-sm text-slate-700 dark:text-slate-300">Belum Ada Produk Terdaftar</h4>
        <p class="text-xs text-slate-400 mt-1">Daftarkan produk pertanian Anda seperti benih, pupuk, atau peralatan tani.</p>
        <button onclick="openProductModal()" class="mt-4 px-4 py-2 bg-emerald-600 text-white text-xs font-bold rounded-xl shadow">
        + Tambah Produk Baru
        </button>
    </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL: FORM PRODUK (TAMBAH / EDIT)         -->
<!-- ========================================== -->
<div id="modal-product" class="fixed inset-0 z-50 modal-backdrop hidden items-center justify-center p-3 sm:p-4 overflow-y-auto">
<div class="bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-800 max-w-md w-full p-5 sm:p-6">
    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
    <h3 id="modal-product-title" class="font-extrabold text-base text-slate-800 dark:text-slate-100">Tambah Produk Baru</h3>
    <button onclick="closeModal('modal-product')" class="text-slate-400 hover:text-slate-600 p-1">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
    </div>

    <form id="form-product" onsubmit="SubmitProduct(event)" class="mt-4 space-y-3.5">
    <div>
        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Nama Produk / Barang</label>
        <input type="text" id="prod-name" required placeholder="Contoh: Pupuk NPK Mutiara 16-16-16" class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs">
    </div>

    <div>
        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Kategori</label>
        <input type="text" id="prod-category" list="product-category-list" required placeholder="Pilih atau ketik kategori..." class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs">
        <datalist id="product-category-list"></datalist>
    </div>


    <div class="grid grid-cols-2 gap-2.5">
        <div>
        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Stok Awal (Opsional)</label>
        <input type="number" id="prod-stock" placeholder="Kosongkan jika tak dibatasi" class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs">
        </div>
        <div>
        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Status Produk</label>
        <select id="prod-status" class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs">
            <option value="Tersedia">Tersedia</option>
            <option value="Stok Menipis">Stok Menipis</option>
            <option value="Habis">Habis</option>
            <option value="Nonaktif">Nonaktif</option>
        </select>
        </div>
    </div>

    <div class="flex justify-end space-x-2 pt-3 border-t border-slate-100 dark:border-slate-800">
        <button type="button" onclick="closeModal('modal-product')" class="px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-700 text-xs font-bold">Batal</button>
        <button type="submit" class="px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow">Simpan Produk</button>
    </div>
    </form>
</div>
</div>

@section Scripts {
    <script>

        $(document).ready(function(){
            
        });

        function openProductModal(){
            const modal = document.getElementById('modal-product');
            if(modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            }
        };

        function closeModal(modalId) {
            const modal = document.getElementById(modalId);
            if(modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        };

        function SubmitProduct(e) {
            e.preventDefault();
            $.ajax({
                url: @Url.Action("CreateNewProduct","Product"),
                type: 'POST',
                success: function(){

                },
            });
        };

        function 
    </script>
}