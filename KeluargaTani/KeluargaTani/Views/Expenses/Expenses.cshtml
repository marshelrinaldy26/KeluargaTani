@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Expenses - Keluarga Tani";
}

<div id="view-Expenses" class="app-view space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div>
        <h2 class="text-xl font-black tracking-tight text-slate-800 dark:text-slate-100">Manajemen Pengeluaran</h2>
        <p id="Expenses-count-info" class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Memuat data pengeluaran...</p>
    </div>
    <button onclick="openExpensesModal()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl shadow transition flex items-center space-x-1.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        <span>Tambah Pengeluaran</span>
    </button>
    </div>

    <!-- Expenses Table -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
        <table id="ExpensesTable" class="w-full text-left border-collapse text-xs">
        <thead>
            <tr class="bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 font-bold uppercase text-[10px]">
                <th class="py-3 px-3 text-center">No</th>
                <th class="py-3 px-3">Nama Produk</th>
                <th class="py-3 px-3">Kriteria</th>
                <th class="py-3 px-3 text-center">Jumlah Pengeluaran</th>
                <th class="py-3 px-3 text-center">Tanggal Pengeluaran</th>
                <th class="py-3 px-3 text-center">Aksi</th>
            </tr>
            <tr id="filterRow">
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody id="Expenses-table-tbody">
            <!-- Data diisi oleh JavaScript -->
        </tbody>
        </table>
    </div>

    <div id="Expenses-empty-state" class="hidden py-12 px-4 text-center">
        <div class="text-3xl mb-2">💸</div>
        <h4 class="font-bold text-sm text-slate-700 dark:text-slate-300">Belum Ada Pengeluaran Terdaftar</h4>
        <p class="text-xs text-slate-400 mt-1">Catat pengeluaran Anda seperti modal tanam atau perawatan.</p>
        <button onclick="openExpensesModal()" class="mt-4 px-4 py-2 bg-emerald-600 text-white text-xs font-bold rounded-xl shadow">
        + Tambah Pengeluaran Baru
        </button>
    </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL: FORM PENGELUARAN (TAMBAH / EDIT)    -->
<!-- ========================================== -->
<div id="modal-Expenses" class="fixed inset-0 z-50 modal-backdrop hidden items-center justify-center p-3 sm:p-4 overflow-y-auto">
<div class="bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-800 max-w-md w-full p-5 sm:p-6">
    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
    <h3 id="modal-Expenses-title" class="font-extrabold text-base text-slate-800 dark:text-slate-100">Tambah Pengeluaran</h3>
    <button onclick="closeExpensesModal()" class="text-slate-400 hover:text-slate-600 p-1">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
    </div>

    <form id="form-Expenses" onsubmit="SubmitExpenses(event)" class="mt-4 space-y-3.5">
    <div>
        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Produk</label>
        <select id="exp-produk" required class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs">
            <option value="">Pilih Produk...</option>
        </select>
    </div>

    <div>
        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Kriteria</label>
        <select id="exp-kriteria" required class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs">
            <option value="Modal Tanam">Modal Tanam</option>
            <option value="Modal Perawatan">Modal Perawatan</option>
            <option value="Modal Tanam Dan Pewatan">Modal Tanam Dan Perawatan</option>
            <option value="Pengeluaran Lain">Pengeluaran Lain</option>
        </select>
    </div>

    <div class="grid grid-cols-2 gap-2.5">
        <div>
        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Jumlah Pengeluaran</label>
        <input type="number" id="exp-jumlah" required placeholder="0" class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs">
        </div>
        <div>
        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Tanggal</label>
        <input type="date" id="exp-tanggal" required class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs">
        </div>
    </div>

    <div class="flex justify-end space-x-2 pt-3 border-t border-slate-100 dark:border-slate-800">
        <button type="button" onclick="closeExpensesModal()" class="px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-700 text-xs font-bold">Batal</button>
        <button type="submit" class="px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow">Simpan Data</button>
    </div>
    </form>
</div>
</div>

@section Scripts {
    <script>

    $(document).ready(function(){
          initiallizeTable();
          loadProducts();
      });

      function loadProducts() {
          $.ajax({
              url: '@Url.Action("GetProductList", "Product")',
              type: 'GET',
              success: function (data) {
                  const select = $('#exp-produk');
                  select.empty();
                  select.append('<option value="">Pilih Produk...</option>');
                  data.forEach(function (item) {
                      select.append(`<option value="${item.value}">${item.text}</option>`);
                  });
              },
              error: function (err) {
                  console.error('Failed to load products', err);
              }
          });
      }

      let dataTable;
      function initiallizeTable(){
        if(dataTable) dataTable.destroy(); dataTable = null;
        dataTable = $('#ExpensesTable').on('processing.dt', function (e, settings, processing) {
            if (processing) {
                Swal.fire({
                    title: "Memuat Data...",
                    text: "Silahkan tunggu sebentar",
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
            } else {
                Swal.close();
            }
        }).DataTable({
                    serverSide: true,
                    processing: true,
                    ajax: {
                        url: '@Url.Action("ReadExpensesData", "Expenses")',
                        type: 'POST',
                        data: {
                        },
                        dataSrc: function (json) {
                            return json.data; 
                        },
                    },
                    columns: [
                        { 
                            data: null,
                            orderable: false,
                            searchable: false,
                            render: function (data, type, row, meta) {
                                return meta.row + meta.settings._iDisplayStart + 1;
                            }
                        },
                        { data: 'namaProduk' },
                        { data: 'kriteria' },
                        { data: 'jumlahPengeluaran' },
                        { data: 'tanggalPengeluaran' },
                        {
                            data: null,
                            render: function(data, type, row){
                                return '<button type="button" class="btn btn-sm btn-danger" onclick="">Delete</button>';
                            }
                        },
                    ],
                    columnDefs: [
                        {
                            targets: '_all',
                            className: 'dt-center',
                        },
                    ],
                    initComplete: function () {
                        ShowSearchRowWithDateAndBoolean({
                            api: this.api(),
                            excluded: [0,5],
                            dateColumns: [],
                            booleanColumns: [],
                            colLimit: 5,
                        });

                        $('#filterRow').show();
                        baseInitComplete.call(this);
                    },
                    drawCallback: function () {
                    }
                });

        }

        function openExpensesModal(e){
           $('#modal-Expenses').removeClass('hidden').addClass('flex');

        };

        function SubmitExpenses(e) {
           e.preventDefault();
           const idProduk = $('#exp-produk').val();
           const kriteria = $('#exp-kriteria').val();
           const jumlah = $('#exp-jumlah').val();
           const tanggal = $('#exp-tanggal').val();

           $.ajax({
               url: '@Url.Action("CreateNewExpense","Expenses")', 
               type: 'POST',
               data: {
                   idProduk: idProduk,
                   kriteria: kriteria,
                   jumlahPengeluaran: jumlah,
                   tanggalPengeluaran: tanggal
               },
               success: function(response){
                   Swal.fire({
                           title: 'Berhasil',
                           text: 'Berhasil Membuat Pengeluaran Baru',
                           icon: 'success',
                           confirmButtonText: 'OK'
                       }).then(() => {
                           closeExpensesModal();
                           dataTable.ajax.reload();
                       });
               },
               error: function(err){
                   console.error('error:', err);
               }
           });
        };

        function closeExpensesModal() {
            $('#modal-Expenses').removeClass('flex').addClass('hidden');
            $('#form-Expenses')[0].reset();
        }
    </script>
}