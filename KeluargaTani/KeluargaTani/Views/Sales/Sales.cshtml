@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Sales - Keluarga Tani";
}
<div id="view-sales" class="app-view space-y-6">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div>
        <h2 class="text-xl font-black tracking-tight text-slate-800 dark:text-slate-100">Data Transaksi Penjualan</h2>
        @* <p id="sales-count-info" class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Memuat data...</p> *@
    </div> 
    <div class="flex flex-wrap items-center gap-2">
        <button onclick="openEksportExcel()" class="px-3.5 py-2 bg-emerald-50 dark:bg-emerald-950/40 hover:bg-emerald-100 text-emerald-700 dark:text-emerald-300 text-xs font-bold rounded-xl border border-emerald-300 dark:border-emerald-800 transition flex items-center space-x-1.5 shadow-sm">
        <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
        <span>Export Excel</span>
        </button>

        <button onclick="openSaleModal()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl shadow transition flex items-center space-x-1.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        <span>Catat Penjualan Baru</span>
        </button>
    </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2.5">
        
        <!-- Search Box -->
        <div class="lg:col-span-2">
        <label class="block text-[11px] font-bold text-slate-500 mb-1">Cari Transaksi</label>
        <div class="relative">
            <input type="text" id="sales-search-input" placeholder="Cari nama pembeli, barang, kategori..." class="w-full pl-8 pr-3 py-2 text-xs rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-emerald-500">
            <svg class="w-4 h-4 text-slate-400 absolute left-2.5 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
        </div>

        <!-- Filter Kategori -->
        <div>
        <label class="block text-[11px] font-bold text-slate-500 mb-1">Product</label>
        <select id="sales-filter-product" class="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100">
            <option value="all">Product</option>
        </select>
        </div>

        <!-- Filter Status Margin -->
        <div>
        <label class="block text-[11px] font-bold text-slate-500 mb-1">Status Margin</label>
        <select id="sales-filter-margin" class="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100">
            <option value="all">Semua Margin</option>
            <option value="green">🟢 Hijau (≥30% Target)</option>
            <option value="yellow">🟡 Kuning (15-29%)</option>
            <option value="red">🔴 Merah (&lt;15%)</option>
        </select>
        </div>

        <!-- Filter Tanggal -->
        <div class="flex items-center space-x-1.5">
        <div class="flex-1">
            <label class="block text-[11px] font-bold text-slate-500 mb-1">Dari</label>
            <input type="date" id="sales-filter-start" class="w-full px-2 py-1.5 text-xs rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800">
        </div>
        <div class="flex-1">
            <label class="block text-[11px] font-bold text-slate-500 mb-1">Sampai</label>
            <input type="date" id="sales-filter-end" class="w-full px-2 py-1.5 text-xs rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800">
        </div>
        </div>

    </div>
    </div>

    <!-- Sales Table -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
        <thead>
            <tr class="bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 font-bold uppercase text-[10px]">
            <th class="py-3 px-3 text-center">No</th>
            <th class="py-3 px-3">Tanggal</th>
            <th class="py-3 px-3">Pembeli</th>
            <th class="py-3 px-3">Barang / Kategori</th>
            <th class="py-3 px-3 text-right">Harga & Modal</th>
            <th class="py-3 px-3 text-center">Qty</th>
            <th class="py-3 px-3 text-right">Diskon</th>
            <th class="py-3 px-3 text-right">Total Jual</th>
            <th class="py-3 px-3 text-right">Profit</th>
            <th class="py-3 px-3 text-center">Margin</th>
            <th class="py-3 px-3 text-center">Aksi</th>
            </tr>
        </thead>
        <tbody id="sales-table-tbody">
            <!-- Data penjualan diisi oleh JavaScript -->
        </tbody>
        </table>
    </div>

    <!-- Empty State -->
    <div id="sales-empty-state" class="hidden py-12 px-4 text-center">
        <div class="w-12 h-12 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-400 flex items-center justify-center mx-auto mb-3 text-xl">
        📦
        </div>
        <h4 class="font-bold text-sm text-slate-700 dark:text-slate-300">Belum Ada Transaksi Penjualan</h4>
        <p class="text-xs text-slate-400 mt-1 max-w-sm mx-auto">Mulai catat penjualan barang pertanian Anda atau muat data contoh untuk eksplorasi.</p>
        <button onclick="openSaleModal()" class="mt-4 px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl shadow">
        + Catat Penjualan Sekarang
        </button>
    </div>
    </div>
</div>


<div id="modal-sale" class="fixed inset-0 z-50 modal-backdrop hidden items-center justify-center p-3 sm:p-4 overflow-y-auto">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-800 max-w-2xl w-full p-5 sm:p-6 my-8">
      <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
        <h3 id="modal-sale-title" class="font-extrabold text-base text-slate-800 dark:text-slate-100">Catat Penjualan Baru</h3>
        <button onclick="closeModal('modal-sale')" class="text-slate-400 hover:text-slate-600 p-1">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <form id="form-sale" onsubmit="handleSaleSubmit(event)" class="mt-4 space-y-4">
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Tanggal Transaksi</label>
            <input type="date" id="sale-date" required class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Pilih Pembeli Terdaftar</label>
            <select id="sale-cust-select" class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs">
              <!-- Diisi otomatis -->
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Nama Pembeli</label>
          <input type="text" id="sale-customer-name" required placeholder="Ketik nama pembeli..." class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs">
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Pilih dari Master Produk</label>
            <select id="sale-prod-select" onchange="onProductSelectChange(this.value)" class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs">
              <!-- Diisi otomatis -->
            </select>
          </div>
          
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Nama / Jenis Barang</label>
          <input type="text" id="sale-product-name" required placeholder="Contoh: Pupuk NPK Mutiara 1kg" class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs">
        </div>

        <div class="grid grid-cols-3 gap-2.5">
          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Harga Jual / Unit (Rp)</label>
            <input type="number" id="sale-selling-price" required oninput="calculateSaleFormLive()" placeholder="0" class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs font-bold text-slate-800 dark:text-slate-100">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Modal / Unit (Rp)</label>
            <input type="number" id="sale-cost-price" required oninput="calculateSaleFormLive()" placeholder="0" class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Jumlah (Qty)</label>
            <input type="number" id="sale-qty" value="1" min="1" required oninput="calculateSaleFormLive()" class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs font-bold text-center">
          </div>
        </div>

        <!-- Diskon Box -->
        <div class="grid grid-cols-2 gap-2.5">
          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Tipe Diskon</label>
            <select id="sale-discount-type" onchange="calculateSaleFormLive()" class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs">
              <option value="nom">Nominal Rupiah (Rp)</option>
              <option value="pct">Persentase (%)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Nilai Diskon</label>
            <input type="number" id="sale-discount-value" value="0" oninput="calculateSaleFormLive()" class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs">
          </div>
        </div>

        <!-- LIVE CALCULATION SUMMARY BOX -->
        <div class="p-4 bg-slate-50 dark:bg-slate-800/80 rounded-2xl border border-slate-200 dark:border-slate-700 space-y-2">
          <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Perhitungan Otomatis Real-Time:</div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
            <div>
              <div class="text-slate-400">Total Penjualan:</div>
              <div id="calc-live-total-sales" class="font-bold text-slate-800 dark:text-slate-100 text-sm">Rp 0</div>
            </div>
            <div>
              <div class="text-slate-400">Total Modal:</div>
              <div id="calc-live-total-cost" class="font-bold text-slate-800 dark:text-slate-100 text-sm">Rp 0</div>
            </div>
            <div>
              <div class="text-slate-400">Laba / Profit:</div>
              <div id="calc-live-profit" class="font-black text-emerald-600 text-sm">Rp 0</div>
            </div>
            <div>
              <div class="text-slate-400">Margin Laba:</div>
              <div class="flex items-center space-x-1.5 mt-0.5">
                <span id="calc-live-margin" class="font-black text-sm">0%</span>
                <span id="calc-live-margin-badge" class="px-2 py-0.5 rounded text-[10px] font-bold margin-badge-green">Target ≥30%</span>
              </div>
            </div>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Catatan Tambahan (Opsional)</label>
          <input type="text" id="sale-notes" placeholder="Contoh: Dibayar tunai, tempo 3 hari, atau bonus bibit..." class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs">
        </div>

        <div class="flex justify-end space-x-2 pt-3 border-t border-slate-100 dark:border-slate-800">
          <button type="button" onclick="closeModal('modal-sale')" class="px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-700 text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-100 transition">
            Batal
          </button>
          <button type="submit" class="px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow transition">
            Simpan Transaksi
          </button>
        </div>

      </form>
    </div>
  </div>

@section Scripts {
    <script>

        $(document).ready(function(){
           
        });

        function loadDaftarPembeli() {
            $.ajax({
                url: '@Url.Action("GetCustomerList", "Customer")',
                type: 'GET',
                dataType: 'json',
                success: function (data) {
                    const $select = $('#sale-cust-select');
                    $select.empty().append('<option value=""></option>');
                    $.each(data, function (index, item) {
                        $select.append(new Option(item.text, item.value));
                    });
                    $select.select2({
                        width: '100%',
                        placeholder: "-- Pilih Pembeli Terdaftar --",
                        allowClear: true
                    });
                }
            });
        }

        function loadDaftarProduk() {
            $.ajax({
                url: '@Url.Action("GetProductList", "Product")',
                type: 'GET',
                dataType: 'json',
                success: function (data) {
                    const $select = $('#sale-prod-select');
                    $select.empty().append('<option value=""></option>');
                    $.each(data, function (index, item) {
                        $select.append(new Option(item.text, item.value));
                    });
                    $select.select2({
                        width: '100%',
                        placeholder: "-- Pilih Produk --",
                        allowClear: true
                    });
                }
            });
        }

        function openSaleModal() {
            loadDaftarPembeli();
            loadDaftarProduk();
            $('#modal-sale').removeClass('hidden').addClass('flex');
        };

        function openImportModal() {
            const modal = document.getElementById('modal-import-excel');
            if(modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            } else {
                alert("Kode HTML untuk Modal Import Excel belum dimasukkan ke halaman ini.");
            }
        };

        function closeModal(modalId) {
            const modal = document.getElementById(modalId);
            if(modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        };

        function exportSalesExcel() { alert("Fitur ekspor excel akan dibuat di C# Controller."); };
        function handleSaleSubmit(event) { 
            event.preventDefault(); 
            alert("Tombol simpan diklik! Anda bisa menambahkan AJAX jQuery di sini nanti."); 
            closeModal('modal-sale'); 
        };
        function calculateSaleFormLive() { console.log('Kalkulasi otomatis berjalan...'); };
    </script>
}